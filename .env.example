# Welcher Anbieter genutzt wird: "stayingapi" oder "hotelbeds"
HOTEL_PROVIDER=stayingapi

# --- StayingAPI (stayingapi.com) ---
# Kostenloser Signup ohne Kreditkarte, 50 Gratis-Requests
STAYINGAPI_KEY=

# --- Hotelbeds APItude (developer.hotelbeds.com) ---
# Kostenloser Evaluation-Tarif nach Registrierung
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
# "test" = Sandbox (Evaluation-Tarif), "production" = Live-Vertrag
HOTELBEDS_ENV=test

PORT=3000
